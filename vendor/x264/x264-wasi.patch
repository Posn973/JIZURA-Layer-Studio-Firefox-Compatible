 #define x264_pthread_t               pthread_t
+#ifdef __wasi__
+/* JIZURA改: WebAssembly threads get a small default stack; x264's analysis needs more */
+static inline int x264_pthread_create( pthread_t *t, const pthread_attr_t *a, void *(*f)(void *), void *d )
